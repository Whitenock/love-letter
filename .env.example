# Скопируй этот файл в .env в корне проекта и заполни значения.
# Файл .env не коммитится в git (см. .gitignore).

# Токен бота от @BotFather. Формат: 123456789:AAExampleToken_Chars
BOT_TOKEN=

# Публичный HTTPS-адрес, на котором развёрнут frontend (Mini App).
# Для локальной разработки см. README (раздел про HTTPS-туннель).
WEBAPP_URL=

# Порт локального HTTP-сервера backend (healthcheck и проверка initData)
PORT=3000

# Максимальный возраст initData в секундах (защита от replay-атак)
INIT_DATA_MAX_AGE_SEC=86400

# --- GitHub Pages (деплой PWA) ---
# Логин на github.com
GH_USERNAME=
# Personal Access Token: github.com -> Settings -> Developer settings ->
# Personal access tokens -> Fine-grained. Права: Contents (R+W),
# Administration (R+W) — для автоматического создания репозитория.
GH_TOKEN=
# Имя репозитория (необязательно; по умолчанию love-letter)
GH_REPO_NAME=love-letter
