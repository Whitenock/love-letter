rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Комнаты рисования: любой аутентифицированный пользователь
    // (анонимный вход) может читать и писать штрихи в комнате,
    // если знает её код. Код комнаты — общий секрет пары.
    match /rooms/{roomId}/strokes/{strokeId} {
      allow read, write: if request.auth != null;
    }
  }
}